---
import Base from "../layouts/Base.astro";
import { site } from "../lib/site.js";
---
<Base title="Page not found · Revanth Reddy" description="This page does not exist." path="/404" navBase="/" noindex>
  <section class="hero lost" aria-labelledby="lost-h">
    <div class="hero-text">
      <p class="status"><span class="code">404</span>Page not found</p>
      <h1 id="lost-h">Nothing lives at this address.</h1>
      <p class="bio">The link may be old or mistyped. Everything on this site is on one page.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to the home page</a>
        <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</Base>
