---
import "@fontsource-variable/public-sans";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { site } from "../lib/site.js";

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Prefix for in-page nav links: "" on the home page, "/" elsewhere. */
  navBase?: string;
  noindex?: boolean;
  jsonLd?: object;
}
const { title, description, path = "/", navBase = "", noindex = false, jsonLd } = Astro.props;


const canonical = new URL(path, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const built = new Date().toISOString().slice(0, 10);
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#0c0c0c"/><text x="16" y="21.5" font-family="ui-monospace,monospace" font-size="14" font-weight="700" fill="#f5f5f5" text-anchor="middle">RR</text><circle cx="25" cy="7" r="2.5" fill="#8f8fff"/></svg>`
  );
const nav = [
  ["work", "Work"],
  ["exploring", "Exploring"],
  ["stack", "Stack"],
  ["contact", "Contact"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfbfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Revanth Reddy, full-stack developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Set theme and project view before first paint to avoid a flash.
      (function () {
        var d = document.documentElement, t = null, v = null;
        d.classList.add("js");
        // Section reveal is opt-in: only with motion allowed, and undone if the page script never runs.
        if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          d.classList.add("reveal-ready");
          setTimeout(function () { if (!window.__reveal) d.classList.remove("reveal-ready"); }, 3000);
        }
        try { t = localStorage.getItem("theme"); v = localStorage.getItem("view"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        if (t === "dark") d.classList.add("dark");
        if (v === "grid") d.dataset.view = "grid";
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="edge edge-top" aria-hidden="true"></div>
    <div class="edge edge-bottom" aria-hidden="true"></div>

    <header class="topbar">
      <div class="topbar-inner">
        <a class="wordmark" href={navBase || "#top"} aria-label="Revanth Reddy, back to top">Revanth Reddy</a>
        <nav class="nav" aria-label="Sections">
          {nav.map(([id, label]) => <a href={`${navBase}#${id}`}>{label}</a>)}
        </nav>
        <div class="seg" role="group" aria-label="Colour theme">
          <button type="button" class="seg-btn" data-theme-choice="light" aria-pressed="false" aria-label="Light theme" title="Light theme">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"/><g stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1"/></g></svg>
          </button>
          <button type="button" class="seg-btn" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark theme">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M13.5 9.6A5.6 5.6 0 0 1 6.4 2.5a5.6 5.6 0 1 0 7.1 7.1z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> · <a href={site.repo} target="_blank" rel="noopener noreferrer">source on GitHub<span class="sr-only"> (opens in a new tab)</span></a></span>
      <span class="mono">Built <time datetime={built}>{built}</time></span>
    </footer>

    <script>
      const root = document.documentElement;
      const store = {
        get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
        set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* storage blocked */ } },
      };

      // Theme: an explicit choice is saved; otherwise follow the OS setting.
      const mq = matchMedia("(prefers-color-scheme: dark)");
      const themeBtns = document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");
      const themeMetas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
      const applyTheme = (t: string) => {
        root.classList.toggle("dark", t === "dark");
        themeBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeChoice === t)));
        themeMetas.forEach((m) => m.setAttribute("content", t === "dark" ? "#0c0c0c" : "#fbfbfb"));
      };
      const saved = store.get("theme");
      applyTheme(saved === "light" || saved === "dark" ? saved : mq.matches ? "dark" : "light");
      themeBtns.forEach((b) => b.addEventListener("click", () => {
        const t = b.dataset.themeChoice!;
        store.set("theme", t);
        applyTheme(t);
      }));
      mq.addEventListener("change", (e) => {
        const s = store.get("theme");
        if (s !== "light" && s !== "dark") applyTheme(e.matches ? "dark" : "light");
      });

      // Sticky bar: hairline and blur once the page has scrolled.
      const onScroll = () => root.toggleAttribute("data-scrolled", scrollY > 8);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Section reveal. Content is visible without JS; with reduced motion nothing is hidden.
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if (root.classList.contains("reveal-ready")) {
        (window as any).__reveal = true;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        }, { rootMargin: "0px 0px -8% 0px" });
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
